# Copy this file to .env and replace every REPLACE_ME value before deployment.
# These placeholders intentionally fail production authentication checks.
TWIN_ENV_FILE=.env
TWIN_TOKEN_BRAIN=REPLACE_ME
TWIN_TOKEN_GUARDIAN=REPLACE_ME
TWIN_TOKEN_OPERATOR=REPLACE_ME
TWIN_TOKEN_EVALUATOR=REPLACE_ME
TWIN_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional values. Set only when appropriate for the target deployment.
# PORT=8000
# TWIN_ALLOWED_ORIGINS=
# TWIN_RUN_ID=
# TWIN_LOG_DIR=logs
# TWIN_STATE_DB_PATH=logs/twin-state.sqlite3
# TWIN_TRUSTED_PROXY_IPS=127.0.0.1
